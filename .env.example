# ============================================================
#  Copie este arquivo para ".env" e preencha o que você for usar.
#      cp .env.example .env
#  O arquivo .env NUNCA vai para o GitHub (está no .gitignore).
# ============================================================

# Qual provedor de LLM usar: mock | openai | anthropic
# "mock" roda SEM internet e SEM chave de API. Ótimo pra testar o fluxo.
AGENT_CREW_PROVIDER=mock

# Nome do modelo (usado quando o provedor é openai ou anthropic)
AGENT_CREW_MODEL_NAME=gpt-4o-mini

# Sua chave de API (só preencha a do provedor que for usar)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Temperatura do modelo (0 = mais previsível, 1 = mais criativo)
AGENT_CREW_TEMPERATURE=0.2

# Quantas vezes o revisor pode devolver o texto para o redator
AGENT_CREW_MAX_REVISIONS=1

# Busca na web: mock | tavily
# "mock" devolve resultados de exemplo, sem precisar de chave.
AGENT_CREW_SEARCH_BACKEND=mock
TAVILY_API_KEY=

# IDIOMA usado nas instruções dos agentes
AGENT_CREW_LANGUAGE=pt-BR
